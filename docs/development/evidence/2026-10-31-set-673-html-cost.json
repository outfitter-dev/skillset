  "workloadScript": "import { createHash } from \"node:crypto\";\nimport { join } from \"node:path\";\nimport { pathToFileURL } from \"node:url\";\n\nconst [repo, scenario] = process.argv.slice(2);\nif (!repo || !scenario) throw new Error(\"expected checkout and scenario\");\nconst { markdownCodeRanges } = await import(pathToFileURL(join(repo, \"packages/core/src/preprocess.ts\")).href);\nconst { markdownLinkIsActive } = await import(pathToFileURL(join(repo, \"packages/core/src/markdown-link-context.ts\")).href);\nconst tick = String.fromCharCode(96);\nlet content: string;\nlet operation = \"ranges\";\nswitch (scenario) {\n  case \"million-runs\": content = (tick + \"a\").repeat(1_000_000); break;\n  case \"million-inline-tag\": content = (tick + \"a\").repeat(1_000_000) + \" <widget>\"; break;\n  case \"million-html-block\": content = \"<div>\\n\" + (tick + \"a\").repeat(1_000_000) + \"\\n</div>\"; break;\n  case \"million-before-html\": content = (tick + \"a\").repeat(1_000_000) + \"\\n\\n<div>\\ntext\\n</div>\"; break;\n  case \"many-comments\":\n    content = (\"<!-- \" + tick + \"x\" + tick + \" [hidden](a.md) -->\\n\\n\").repeat(1000) + \"[active](b.md)\";\n    operation = \"links\"; break;\n  default: throw new Error(\"unknown scenario\");\n}\nconst contentHash = createHash(\"sha256\").update(content).digest(\"hex\");\nconst start = Bun.nanoseconds();\nlet observation;\nif (operation === \"ranges\") {\n  const ranges = markdownCodeRanges(content);\n  observation = { rangeCount: ranges.length, first: ranges[0], last: ranges.at(-1) };\n} else {\n  const active = markdownLinkIsActive(content);\n  observation = {\n    hiddenActive: active(\"[hidden](a.md)\", content.indexOf(\"[hidden](a.md)\")),\n    finalActive: active(\"[active](b.md)\", content.lastIndexOf(\"[active](b.md)\")),\n  };\n  if (observation.hiddenActive || !observation.finalActive) throw new Error(\"link classification failed\");\n}\nconsole.log(JSON.stringify({ scenario, bytes: Buffer.byteLength(content), contentHash, elapsedMs: (Bun.nanoseconds() - start) / 1e6, observation }));\n",
